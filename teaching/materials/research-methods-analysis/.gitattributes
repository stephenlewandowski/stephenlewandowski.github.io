# Preserve the exact resource bytes recorded in provenance.json on every platform.
* -text
# The source CSV uses CRLF; retain its checksum without flagging CR as whitespace.
*.csv whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve the source WebVTT's final cue separator.
*.vtt whitespace=-blank-at-eof
